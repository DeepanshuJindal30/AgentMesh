# AgentMesh environment template
# Copy to .env and adjust. Never commit .env.

# --- Core ---
COMPOSE_PROJECT_NAME=agentmesh
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=agentmesh
POSTGRES_PASSWORD=agentmesh_dev_password
POSTGRES_DB=agentmesh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agentmesh:agentmesh_dev_password@postgres:5432/agentmesh

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=agentmesh
RABBITMQ_PASSWORD=agentmesh_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://agentmesh:agentmesh_dev_password@rabbitmq:5672//
CELERY_BROKER_URL=amqp://agentmesh:agentmesh_dev_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=agentmesh
KEYCLOAK_CLIENT_ID=agentmesh-web
KEYCLOAK_CLIENT_SECRET=  # public PKCE client; leave empty for public client

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
SERVICE_NAME=api

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
WEB_PORT=3000

# --- Runtime / LLM (optional) ---
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- gRPC ---
RUNTIME_GRPC_HOST=runtime
RUNTIME_GRPC_PORT=50051

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
